<engine:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:engine="UnityEngine.UIElements" xmlns:editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <engine:Button text="☰ " name="scheduleButton" style="position: absolute; right: 27px; border-top-left-radius: 7px; border-top-right-radius: 7px; border-bottom-right-radius: 7px; border-bottom-left-radius: 7px; width: 30px; height: 30px; -unity-text-align: middle-center; top: -1px;" />
    <engine:VisualElement name="schedulePanel" style="flex-grow: 1; width: 644px; -unity-text-align: upper-right; white-space: nowrap; right: 79px; height: 312px; background-color: rgba(47, 47, 47, 0.65); align-self: center;">
        <engine:Label text="Schedule" name="scheduleTitle" style="font-size: 16px; -unity-text-align: upper-right; -unity-font-style: bold; width: 552px; color: rgb(255, 255, 255);" />
        <engine:VisualElement name="welcomeSection" style="flex-grow: 1; height: 111px; width: 609px;">
            <engine:Label text="Welcome Reception" name="welcome" style="font-size: 18px; -unity-text-align: upper-center; -unity-font-style: bold; color: rgb(255, 255, 255);" />
            <engine:Label text=" Time           |   March 04, 2025&#10;                             9:00 AM - 11:40 AM" name="time" style="font-size: 14px; -unity-font-style: bold; width: 600px; -unity-text-align: middle-center; height: 56px; color: rgb(255, 255, 255);" />
            <engine:Label text="Speaker      |  John Oldenburg" name="speaker" style="font-size: 14px; -unity-font-style: bold; width: 604px; -unity-text-align: upper-center; color: rgb(253, 250, 250);" />
            <engine:Label text="                                     Description  |  Opening Ceremony" name="des" style="font-size: 14px; -unity-font-style: bold; width: 602px; -unity-text-align: upper-left; align-self: auto; color: rgb(255, 255, 255);" />
            <engine:Button text="Attend" name="attendButton1" style="width: 100px; height: 25px; right: 258px; position: absolute; top: 169px; left: 244px; border-top-left-radius: 5px; border-top-right-radius: 5px; border-bottom-right-radius: 5px; border-bottom-left-radius: 5px;" />
        </engine:VisualElement>
        <engine:VisualElement name="conversationSection" style="flex-grow: 1; width: 608px; height: 111px;">
            <engine:Label text="In-Conversation" style="font-size: 18px; -unity-font-style: bold; -unity-text-align: upper-center; color: rgb(255, 255, 255);" />
            <engine:Label text=" Time          |   March 04, 2025&#10;                             12:00 PM - 1:40 PM" name="time" style="font-size: 14px; -unity-font-style: bold; width: 604px; -unity-text-align: middle-center; height: 56px; color: rgb(255, 255, 255);" />
            <engine:Label text="Speaker      |  John Oldenburg" name="speaker" style="font-size: 14px; -unity-font-style: bold; width: 602px; -unity-text-align: upper-center; color: rgb(255, 255, 255);" />
            <engine:Label text="                                     Description  |  Opening Ceremony" name="des" style="font-size: 14px; -unity-font-style: bold; width: 604px; -unity-text-align: upper-left; align-self: auto; color: rgb(255, 255, 255);" />
            <engine:Button text="Attend" name="attendButton2" style="width: 100px; height: 25px; bottom: 25px; right: 261px; left: 240px; top: 196px; border-top-left-radius: 5px; border-top-right-radius: 5px; border-bottom-right-radius: 5px; border-bottom-left-radius: 5px; position: absolute;" />
        </engine:VisualElement>
    </engine:VisualElement>
    <engine:Button text="X" name="closeButton" style="font-size: 20px; -unity-font-style: bold; border-top-left-radius: 7px; border-top-right-radius: 7px; border-bottom-right-radius: 7px; border-bottom-left-radius: 7px; width: 30px; height: 30px; position: absolute; left: 602px; background-color: rgba(255, 0, 0, 0.26); top: 39px;" />
</engine:UXML>
